function getVerificationData(userVerified: boolean, verificationStatus?: string) {
  const status = verificationStatus || (userVerified ? 'verified' : 'unverified');

  if (status === 'verified') {
    return {
      status,
      title: 'Perfil verificado',
      label: 'Identidade aprovada',
      description:
        'Sua identidade foi validada. Seu perfil tem acesso completo às funções liberadas pelo seu plano.',
      color: COLORS.green,
      backgroundColor: COLORS.greenSoft,
      borderColor: 'rgba(49,214,163,0.30)',
      image: ELUS_VERIFIED_GREEN,
    };
  }

  if (status === 'in_review') {
    return {
      status,
      title: 'Verificação em análise',
      label: 'Aguardando aprovação',
      description:
        'Sua selfie com documento foi enviada para análise. Até a aprovação, seu perfil continua como não verificado e com uso limitado.',
      color: COLORS.gold,
      backgroundColor: COLORS.goldSoft,
      borderColor: 'rgba(242,169,59,0.30)',
      image: ELUS_SECURITY_ORANGE,
    };
  }

  return {
    status,
    title: 'Perfil não verificado',
    label: 'Identidade pendente',
    description:
      'Valide sua identidade para ter acesso completo, solicitar contatos e aparecer com mais confiança dentro do ELUS.',
    color: COLORS.danger,
    backgroundColor: COLORS.dangerSoft,
    borderColor: 'rgba(255,107,107,0.30)',
    image: ELUS_UNVERIFIED,
  };
}

function AccountRow({
  icon,
  title,
  description,
  onPress,
  color = COLORS.cyan,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  title: string;
  description: string;
  onPress: () => void;
  color?: string;
}) {
  return (
    <Pressable style={({ pressed }) => [styles.accountRow, pressed && styles.pressed]} onPress={onPress}>
      <View style={[styles.rowIconBox, { borderColor: `${color}55`, backgroundColor: `${color}14` }]}>
        <Ionicons name={icon} size={20} color={color} />
      </View>

      <View style={styles.rowTextBox}>
        <Text style={styles.rowTitle}>{title}</Text>
        <Text style={styles.rowDescription}>{description}</Text>
      </View>

      <Ionicons name="chevron-forward" size={20} color={COLORS.muted} />
    </Pressable>
  );
}

export default function AccountScreen() {
  const router = useRouter();
  const { user, logout } = useApp();

  const verification = getVerificationData(user.verified, user.verificationStatus);

  const locationText =
    user.city && user.state ? `${user.city} · ${user.state}` : user.city || user.state || 'Local não informado';

  function goBack() {
    router.back();
  }

  function openVerification() {
    router.push('/verification' as never);
  }

  function openProfileSetup() {
    router.push('/profile-setup' as never);
  }

  function openProfileType() {
    router.push('/profile-type' as never);
  }

  function openPlans() {
    router.push('/plans' as never);
  }

  function openPrivacy() {
    router.push('/privacy' as never);
  }

  async function signOut() {
    Alert.alert('[DEBUG]', 'signOut() foi chamado');
    const { error } = await supabase.auth.signOut();
    console.log('[DEBUG] signOut() error:', error);
    const { data: sessionCheck } = await supabase.auth.getSession();
    console.log(
      '[DEBUG] getSession() logo após signOut():',
      sessionCheck.session ? 'SESSÃO AINDA PRESENTE' : 'null (ok)'
    );
    logout();
    router.replace('/login' as never);
  }

  return (
    <SafeAreaView style={styles.screen}>
      <StatusBar barStyle="light-content" />

      <ScrollView
        style={styles.scroll}
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.topBar}>
          <Pressable style={styles.backButton} onPress={goBack}>
            <Ionicons name="chevron-back" size={26} color={COLORS.text} />
          </Pressable>

          <Image source={ELUS_LOGO} style={styles.topLogo} resizeMode="contain" />

          <View style={styles.backButtonGhost} />
        </View>

        <View style={styles.hero}>
          <View style={styles.heroGlowOne} />
          <View style={styles.heroGlowTwo} />

          <View style={styles.avatarWrap}>
            {user.photo ? (
              <Image source={{ uri: user.photo }} style={styles.avatarImage} />
            ) : (
              <Image source={ELUS_CENTER_SYMBOL} style={styles.avatarSymbol} resizeMode="contain" />
            )}

            <View style={[styles.avatarStatus, { borderColor: verification.color }]}>
              <Image source={verification.image} style={styles.avatarStatusImage} resizeMode="contain" />
            </View>
          </View>

          <Text style={styles.heroEyebrow}>Conta ELUS</Text>
          <Text style={styles.heroTitle}>{user.name || 'Seu perfil'}</Text>
          <Text style={styles.heroDescription}>{user.email || 'E-mail não informado'}</Text>
          <Text style={styles.heroLocation}>{locationText}</Text>
        </View>

        <View
          style={[
            styles.verificationCard,
            {
              backgroundColor: verification.backgroundColor,
              borderColor: verification.borderColor,
            },
          ]}
        >
          <View style={styles.verificationTop}>
            <View style={[styles.verificationIconBox, { borderColor: `${verification.color}55` }]}>
              <Image source={verification.image} style={styles.verificationIcon} resizeMode="contain" />
            </View>

            <View style={styles.verificationTextBox}>
              <Text style={[styles.verificationLabel, { color: verification.color }]}>
                {verification.label}
              </Text>
              <Text style={styles.verificationTitle}>{verification.title}</Text>
            </View>
          </View>

          <Text style={styles.verificationDescription}>{verification.description}</Text>

          <Pressable
            style={({ pressed }) => [
              styles.verificationButton,
              { backgroundColor: verification.status === 'verified' ? COLORS.green : COLORS.blue },
              pressed && styles.pressed,
            ]}
            onPress={openVerification}
          >
            <Text style={styles.verificationButtonText}>
              {verification.status === 'verified'
                ? 'Ver status de identidade'
                : verification.status === 'in_review'
                ? 'Acompanhar verificação'
                : 'Validar identidade'}
            </Text>

            <Ionicons name="arrow-forward" size={20} color={COLORS.text} />
          </Pressable>
        </View>

        <View style={styles.section}>
          <Text style={styles.sectionEyebrow}>Perfil</Text>

          <AccountRow
            icon="person-circle-outline"
            title="Meu perfil"
            description="Visualize e organize as informações principais da sua presença."
            onPress={openProfileSetup}
            color={COLORS.cyan}
          />

          <AccountRow
            icon="create-outline"
            title="Editar perfil"
            description="Atualize nome, foto, cidade, interesses, preferências e dados públicos."
            onPress={openProfileSetup}
            color={COLORS.blue}
          />

          <AccountRow
            icon="git-branch-outline"
            title="Tipo de perfil"
            description="Configure se o perfil é pessoa, empresa ou perfil assistido."
            onPress={openProfileType}
            color={COLORS.gold}
          />
        </View>

        <View style={styles.section}>
          <Text style={styles.sectionEyebrow}>Segurança e acesso</Text>

          <AccountRow
            icon="shield-checkmark-outline"
            title="Verificação de identidade"
            description="Documento oficial, selfie e status de aprovação do perfil."
            onPress={openVerification}
            color={COLORS.gold}
          />

          <AccountRow
            icon="lock-closed-outline"
            title="Privacidade"
            description="Entenda como dados, contatos e documentos devem ser protegidos."
            onPress={openPrivacy}
            color={COLORS.green}
          />
        </View>

        <View style={styles.section}>
          <Text style={styles.sectionEyebrow}>Plano e configurações</Text>

          <AccountRow
            icon="diamond-outline"
            title="Plano ELUS"
            description="Veja plano atual, benefícios e opções premium."
            onPress={openPlans}
            color={COLORS.gold}
          />

          <Pressable style={({ pressed }) => [styles.logoutButton, pressed && styles.pressed]} onPress={signOut}>
            <Ionicons name="log-out-outline" size={21} color={COLORS.danger} />
            <Text style={styles.logoutText}>Sair da conta</Text>
          </Pressable>
        </View>

        <Text style={styles.footer}>ELUS · Identidade real · Conexões reais · Segurança real.</Text>
      </ScrollView>
    </SafeAreaView>
  );
}

