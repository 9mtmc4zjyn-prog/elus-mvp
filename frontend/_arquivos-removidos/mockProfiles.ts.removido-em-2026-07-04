export type BondType =
  | 'family'
  | 'professional'
  | 'interest'
  | 'preference'
  | 'service'
  | 'friendship'
  | 'support';

export type VerificationStatus =
  | 'verified'
  | 'pending'
  | 'unverified'
  | 'rejected';

export type ProfileKind = 'Pessoa' | 'Empresa' | 'Serviço';

export type MockProfile = {
  id: string;
  name: string;
  initials: string;
  kind: ProfileKind;
  type: string;
  location: string;
  distance?: string;
  headline: string;
  company?: string;
  avatarUrl?: string;
  bonds: BondType[];
  verified: boolean;
  verificationStatus: VerificationStatus;
  daysWithoutVerification?: number;
  canRequestContact: boolean;
  canViewFullProfile: boolean;
  isLimited: boolean;
};

export const BOND_COLORS: Record<BondType, string> = {
  family: '#2D64FF',
  professional: '#D9B46A',
  interest: '#20D6B5',
  preference: '#8A3FFC',
  service: '#A9BED8',
  friendship: '#7E8EA6',
  support: '#FF9F1C',
};

export const BOND_LABELS: Record<BondType, string> = {
  family: 'Família',
  professional: 'Profissional',
  interest: 'Interesse',
  preference: 'Preferência',
  service: 'Serviço',
  friendship: 'Amizade',
  support: 'Apoio',
};

export function getBondColor(bond: BondType) {
  return BOND_COLORS[bond] ?? '#8FB3FF';
}

export function getBondLabel(bond: BondType) {
  return BOND_LABELS[bond] ?? 'Vínculo';
}

