export function getProfileById(id?: string) {
  if (!id) return undefined;

  return mockProfiles.find((profile) => profile.id === id);
}

export function getPublicProfiles() {
  return mockProfiles;
}

export function getVerifiedProfiles() {
  return mockProfiles.filter((profile) => profile.verified);
}

export function getLimitedProfiles() {
  return mockProfiles.filter((profile) => profile.isLimited);
}

export function canProfileRequestContact(profile: MockProfile) {
  return profile.verified && profile.canRequestContact && !profile.isLimited;
}

export function canProfileViewFullProfile(profile: MockProfile) {
  return profile.verified && profile.canViewFullProfile && !profile.isLimited;
}