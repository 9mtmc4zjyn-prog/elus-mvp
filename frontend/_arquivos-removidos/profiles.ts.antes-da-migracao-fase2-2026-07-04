export function getProfileVerificationState(
  profileOrStatus: Profile | ProfileStatus
): ProfileVerificationState {
  const status =
    typeof profileOrStatus === "string"
      ? profileOrStatus
      : profileOrStatus.status;

  return PROFILE_VERIFICATION_STATE_BY_STATUS[status];
}

export function isProfileVerified(profile: Pick<Profile, "status">): boolean {
  return profile.status === "verified";
}

export function isProfileUnverified(profile: Pick<Profile, "status">): boolean {
  return profile.status === "unverified";
}

export function isProfileInReview(profile: Pick<Profile, "status">): boolean {
  return profile.status === "in_review";
}

export function isProfileRestrictedByVerification(
  profile: Pick<Profile, "status">
): boolean {
  return profile.status !== "verified";
}

export function profileCanRequestContact(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).access.canRequestContact;
}

export function profileCanViewFullProfiles(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).access.canViewFullProfiles;
}

export function profileCanAppearWithRealPhoto(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).access.canAppearWithRealPhoto;
}

export function profileCanCreateRealConnections(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).access.canCreateRealConnections;
}

export function profileCanSeeConnectionBorders(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).access.canSeeConnectionBorders;
}

export function profileCanUseFullApp(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).access.canUseFullApp;
}

export function shouldShowRealPhotoPublicly(
  profile: Pick<Profile, "status">
): boolean {
  return getProfileVerificationState(profile.status).publicIdentityMode === "real_photo";
}

export function shouldUseUnverifiedPublicSymbol(
  profile: Pick<Profile, "status">
): boolean {
  return (
    getProfileVerificationState(profile.status).publicIdentityMode ===
    "elus_unverified_symbol"
  );
}

export function getPublicProfileDisplayName(profile: Profile): string {
  if (isProfileVerified(profile)) {
    return profile.name;
  }

  return profile.firstName;
}

export function getPublicProfileLocation(profile: Profile): string {
  if (isProfileVerified(profile)) {
    return profile.location;
  }

  return "Localização limitada";
}

export function getPublicProfileRole(profile: Profile): string {
  if (isProfileVerified(profile)) {
    return profile.role;
  }

  if (profile.status === "in_review") {
    return "Perfil em análise";
  }

  return "Perfil não verificado";
}

export function getRestrictedProfileText(profile: Pick<Profile, "status">): string {
  return getProfileVerificationState(profile.status).restrictedMessage;
}

