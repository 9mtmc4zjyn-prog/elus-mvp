// =====================================================
// Listas derivadas para uso futuro nas telas
// =====================================================

export const verifiedProfiles = profiles.filter(
  (profile) => profile.status === "verified"
);

export const unverifiedProfiles = profiles.filter(
  (profile) => profile.status === "unverified"
);

export const inReviewProfiles = profiles.filter(
  (profile) => profile.status === "in_review"
);

export const restrictedProfiles = profiles.filter((profile) =>
  isProfileRestrictedByVerification(profile)
);

export const protectedPublicProfiles = profiles.filter((profile) =>
  isProtectedPublicProfile(profile)
);

// =====================================================
// Bloco de verificação estrutural
// =====================================================

export const profilesVerification = {
  totalProfiles: profiles.length,
  canonicalIds: profiles.map((profile) => profile.id),
  verifiedIds: verifiedProfiles.map((profile) => profile.id),
  unverifiedIds: unverifiedProfiles.map((profile) => profile.id),
  inReviewIds: inReviewProfiles.map((profile) => profile.id),
  restrictedIds: restrictedProfiles.map((profile) => profile.id),
  protectedPublicIds: protectedPublicProfiles.map((profile) => profile.id),

  verificationStates: profiles.reduce<Record<string, ProfileVerificationState>>(
    (acc, profile) => {
      acc[profile.id] = getProfileVerificationState(profile);
      return acc;
    },
    {}
  ),

  aliasesMapped: profiles.reduce<Record<string, string[]>>((acc, profile) => {
    acc[profile.id] = profile.aliases;
    return acc;
  }, {}),
};

